{
  "name": "pneuma-crewtools",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Crew management tools for Foundry VTT and Cyberpunk RED.",
  "scripts": {
    "build": "vite build",
    "dev": "vite build --watch",
    "typecheck": "tsc --noEmit",
    "check": "tsc --noEmit && vite build",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "node --test tests/*.test.mjs"
  },
  "devDependencies": {
    "@types/node": "^24.3.0",
    "prettier": "^3.6.2",
    "typescript": "^5.9.2",
    "vite": "^7.1.3"
  },
  "packageManager": "pnpm@11.19.0"
}
