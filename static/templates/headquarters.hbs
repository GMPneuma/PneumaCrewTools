<form class="payout-inbox-form hq-management">
  <div class="hq-toolbar hq-header"><label>Headquarters
      <select name="selectedHq" data-select-hq>{{#unless hq}}<option
            value=""
          >Choose headquarters</option>{{/unless}}{{#each headquarters}}{{#if
            selected
          }}<option value="{{id}}" selected>{{name}}</option>{{else}}<option
              value="{{id}}"
            >{{name}}</option>{{/if}}{{/each}}</select></label><span
      class="hq-ip-balance"
    >Shared HQ IP <strong>{{ip}}</strong></span>{{#if canManage}}<button
        type="button"
        data-new-hq
      ><i class="fas fa-plus"></i> New HQ</button>{{/if}}</div>
  {{#if canManage}}
    <fieldset class="payout-heading hub-status"><legend><i
          class="fas fa-building"
        ></i>
        HQ Properties</legend>
      <div class="hq-properties">
        <div class="hq-picture">{{#if hasContainer}}<button
              type="button"
              class="hq-image-link"
              data-open-container
              title="Open HQ Container"
              aria-label="Open HQ Container"
            ><img src="{{hq.image}}" alt="{{hq.name}}" /></button>{{else}}<img
              src="modules/pneuma-crewtools/images/headquarters.svg"
              alt="New HQ"
            />{{/if}}<button type="submit" class="hq-save-properties"><i
              class="fas fa-save"
            ></i>
            Save</button></div>
        <div class="hq-property-fields">
          <div class="form-group"><label>Name</label><input
              name="name"
              value="{{hq.name}}"
              maxlength="100"
              required
            /></div>
          <div class="form-group"><label>Description / Location</label><textarea
              name="description"
              rows="2"
              maxlength="2000"
            >{{hq.description}}</textarea></div>
          <div class="hq-capacity-fields"><label>Bedrooms
              <input
                type="number"
                name="bedrooms"
                value="{{hq.bedrooms}}"
                min="0"
                step="1"
              /></label><label>Max improvements
              <input
                type="number"
                name="maxImprovements"
                value="{{hq.maxImprovements}}"
                min="0"
                step="1"
                placeholder="No limit"
              /></label></div>
          <div class="form-group hq-rent-property"><label>Rent type</label><select
              name="rentType"
            ><option value="">Not configured</option>{{#each rentRates}}{{#if
                  selected
                }}<option value="{{id}}" selected>{{name}}
                    ·
                    {{cost}}
                    eb</option>{{else}}<option value="{{id}}">{{name}}
                    ·
                    {{cost}}
                    eb</option>{{/if}}{{/each}}</select><select
              name="rentModifier"
              aria-label="Rent modifier"
            >{{#each rentModifiers}}{{#if selected}}<option
                    value="{{value}}"
                    selected
                  >{{label}}</option>{{else}}<option
                    value="{{value}}"
                  >{{label}}</option>{{/if}}{{/each}}</select></div>
          {{#unless hq}}<div class="form-group"><label>Container</label><select
                name="actorId"
              ><option value="">Create new</option>{{#each containers}}<option
                    value="{{id}}"
                  >{{name}}</option>{{/each}}</select></div>{{/unless}}

        </div></div></fieldset>
  {{else if hq}}<fieldset class="payout-heading hub-status"><legend
      >{{hq.name}}</legend><div class="hq-properties"><button
          type="button"
          class="hq-image-link"
          data-open-container
          title="Open HQ Container"
          aria-label="Open HQ Container"
        ><img src="{{hq.image}}" alt="{{hq.name}}" /></button><div><p
          >{{hq.description}}</p><p>{{hq.bedrooms}} bedrooms</p><p
          >{{hq.improvements.length}}
            improvements{{#if hq.maxImprovements}}
              /
              {{hq.maxImprovements}}{{/if}}</p></div></div></fieldset>{{else}}<p
    >No headquarters yet.</p>{{/if}}
  {{#if hq}}
    <fieldset class="payout-heading hub-status"><legend><i
          class="fas fa-house-user"
        ></i>
        Shared Rent</legend><div class="hq-toolbar"><strong>{{#if
            rentConfigured
          }}{{rentAmount}} eb / month{{else}}Rent not configured{{/if}}</strong><button
          type="button"
          data-rent-open
        >Rent & Contributions</button></div>{{#each rentBills}}<div
          class="hq-rent-bill"
        ><span>{{date}} · {{paid}} / {{total}} eb paid</span><strong
          >{{remaining}} eb due</strong><progress
            value="{{progress}}"
            max="100"
            aria-label="Confirmed rent payments"
          ></progress></div>{{else}}<p class="notes">No outstanding rent bills.</p>{{/each}}</fieldset>
    <fieldset class="payout-heading hub-status"><legend><i
          class="fas fa-tools"
        ></i>
        Improvements</legend><div class="hq-improvements-layout">
        <div class="hq-installed"><table><thead><tr><th>Improvement</th><th
                >Level</th>{{#if canManage}}<th></th>{{/if}}</tr></thead><tbody
            >{{#each hq.improvements}}<tr><td title="{{notes}}">{{name}}</td><td
                  >{{level}}</td>{{#if canManage}}<td><button
                        type="button"
                        data-remove-improvement="{{id}}"
                        title="Remove improvement"
                        aria-label="Remove {{name}}"
                      ><i
                          class="fas fa-trash"
                        ></i></button></td>{{/if}}</tr>{{else}}<tr><td
                    colspan="3"
                  >No improvements yet.</td></tr>{{/each}}</tbody></table></div>
        {{#if canBuy}}<div class="hq-buy"><label for="hq-improvement-choice">Buy
              Improvement</label><select
              id="hq-improvement-choice"
              name="improvementId"
            >{{#each catalog}}<option
                  value="{{id}}"
                  data-description="{{description}}"
                >{{name}}
                  · Level
                  {{level}}
                  ·
                  {{cost}}
                  IP</option>{{/each}}</select><p
              class="notes"
              data-improvement-description
            ></p><button type="button" data-buy-improvement><i
                class="fas fa-shopping-cart"
              ></i>
              Buy with HQ IP</button></div>{{/if}}
      </div></fieldset>{{/if}}
</form>