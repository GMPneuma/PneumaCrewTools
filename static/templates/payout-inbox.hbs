<form class="payout-inbox-form">

  {{#if gmDashboard}}
    <fieldset class="payout-heading hub-status gm-dashboard-panel">
      <legend><i class="fas fa-gauge-high"></i> GM Action</legend>
      <div class="gm-dashboard-actions">
        <button type="button" data-gm-dashboard-action="payout"><i
            class="fas fa-coins"
          ></i>
          Initiate Payout</button>
        <button type="button" data-gm-dashboard-action="exportPayout"><i
            class="fab fa-discord"
          ></i>
          Export Payout to Discord</button>
        <button type="button" data-gm-dashboard-action="calendar"><i
            class="fas fa-calendar"
          ></i>
          Modify GameTime Date</button>
        <button type="button" data-gm-dashboard-action="rent"><i
            class="fas fa-house"
          ></i>
          Mark Rent Due</button>
        <button type="button" data-gm-dashboard-action="playerHub"><i
            class="fas fa-users"
          ></i>
          Show Player Hub</button>
      </div>
    </fieldset>
    <fieldset class="payout-heading hub-status gm-dashboard-panel">
      <legend><i class="fas fa-hourglass-half"></i> Downtime</legend>
      <div class="gm-dashboard-actions">
        <button type="button" data-gm-dashboard-action="expire"><i
            class="fas fa-hourglass-end"
          ></i>
          Expire Outstanding Downtime</button>
        <button type="button" data-gm-dashboard-action="downtime"><i
            class="fas fa-hourglass-half"
          ></i>
          Manage Player Downtime</button>
        <button type="button" data-gm-dashboard-action="adjustDowntime"><i
            class="fas fa-plus-minus"
          ></i>
          Adjust Player Downtime</button>
      </div>
    </fieldset>
    <fieldset class="payout-heading hub-status gm-dashboard-panel">
      <legend><i class="fas fa-building"></i> Headquarters</legend>
      <div class="gm-dashboard-actions">
        <button type="button" data-gm-dashboard-action="hqIp"><i
            class="fas fa-star"
          ></i>
          Adjust Shared HQ IP</button>
        <button type="button" data-gm-dashboard-action="headquarters"><i
            class="fas fa-building"
          ></i>
          Manage Headquarters</button>
      </div>
    </fieldset>
  {{else}}
    <fieldset class="payout-heading hub-status">
      <legend><i class="fas fa-user"></i> Current Status</legend>
      <div class="hub-status-heading">
        {{#if status.hasActor}}
          <label>Character
            <select data-hub-actor aria-label="Character">
              {{#each status.actors}}{{#if selected}}<option
                    value="{{id}}"
                    selected
                  >{{name}}</option>{{else}}<option
                    value="{{id}}"
                  >{{name}}</option>{{/if}}{{/each}}
            </select></label>
        {{else}}<strong>No eligible characters</strong>{{/if}}
      </div>
      <dl class="hub-metrics">
        <div><dt>Downtime</dt><dd>{{status.downtime}}
            <small>days</small>{{#if status.downtimeReady}}<span
                class="hub-metric-detail"
              >{{status.daysToHustle}} to next hustle</span>{{/if}}</dd></div>
        <div><dt>Money{{#if status.hasActor}}<button
                type="button"
                class="hub-ledger-button"
                data-hub-ledger="wealth"
                title="Open Money ledger"
                aria-label="Open Money ledger"
              ><i class="fas fa-book-open" aria-hidden="true"></i>
                Ledger</button>{{/if}}</dt><dd>{{status.money}}
            <small>eb</small>
            <span
              class="hub-metric-detail hub-housing-detail"
              title="Residence: {{rent.residence}}"
            >{{rent.residence}}</span>
            <span
              class="hub-metric-detail hub-housing-detail"
              title="Lifestyle: {{rent.lifestyle}}"
            >{{rent.lifestyle}}</span>
            {{#if rent.pending}}<span class="rent-pending">Rent Payment
                Processing:
                {{rent.pending}}
                eb</span>{{/if}}
            {{#if rent.due}}<span class="rent-pending">Rent & Lifestyle Due</span>{{/if}}
          </dd></div>
        <div><dt>IP{{#if status.hasActor}}<button
                type="button"
                class="hub-ledger-button"
                data-hub-ledger="improvementPoints"
                title="Open IP ledger"
                aria-label="Open IP ledger"
              ><i class="fas fa-book-open" aria-hidden="true"></i>
                Ledger</button>{{/if}}</dt><dd>{{status.ip}}<span
              class="hub-metric-detail"
            >HQ IP:
              {{status.hqIp}}</span></dd></div>
        <div><dt>Reputation{{#if status.hasActor}}<button
                type="button"
                class="hub-ledger-button"
                data-hub-ledger="reputation"
                title="Open Reputation ledger"
                aria-label="Open Reputation ledger"
              ><i class="fas fa-book-open" aria-hidden="true"></i>
                Ledger</button>{{/if}}</dt><dd>{{status.reputation}}{{#each
              status.topFactions
            }}<span class="hub-metric-detail">{{reputation}}
                {{faction}}</span>{{/each}}</dd></div>
      </dl>
      <div class="hub-actions">
        <button type="button" data-hub-downtime><i
            class="fas fa-hourglass-half"
          ></i>
          Spend Downtime</button>
        <button type="button" data-hub-rent><i class="fas fa-house"></i>
          Rent & Lifestyle</button>
        <button type="button" data-hub-headquarters><i
            class="fas fa-building"
          ></i>
          View HQ</button>
        <button type="button" data-hub-reputation><i class="fas fa-flag"></i>
          Faction Reputation</button>

      </div>
      {{#if rent.housingReminder}}<p class="hub-housing-reminder"><i
            class="fas fa-bed"
          ></i>
          {{rent.housingReminder}}</p>{{/if}}
      {{#if status.downtimeNote}}<p
          class="notes"
        >{{status.downtimeNote}}</p>{{/if}}

    </fieldset>
    {{#if nomad.visible}}
      <fieldset class="payout-heading hub-status downtime-nomad hub-nomad">
        <legend><i class="fas fa-car"></i> Nomad · Vehicles</legend>
        <div class="nomad-vehicle-slots">
          {{#each nomad.slots}}
            <div class="nomad-vehicle-slot">
              {{#if occupied}}
                <div class="nomad-vehicle-heading">
                  <button
                    type="button"
                    class="nomad-vehicle-portrait"
                    data-nomad-action="open"
                    data-slot="{{index}}"
                    {{disabled missing}}
                  >
                    <img src="{{img}}" alt="" /><span>{{name}}</span>
                  </button>
                  <button
                    type="button"
                    class="nomad-vehicle-remove"
                    data-nomad-action="remove"
                    data-slot="{{index}}"
                    aria-label="Remove vehicle"
                    title="Remove vehicle"
                  ><i class="fas fa-times"></i></button>
                </div>
                {{#if missing}}<span>Actor missing</span>{{else}}<strong>HP
                    {{hp}}
                    /
                    {{maxHp}}</strong>{{/if}}
              {{else}}
                <span>Vehicle {{number}}</span>
                <button
                  type="button"
                  data-nomad-action="add"
                  data-slot="{{index}}"
                ><i class="fas fa-plus"></i> Add Vehicle</button>
              {{/if}}
            </div>
          {{/each}}
        </div>
      </fieldset>
    {{/if}}
    {{#if netrunner.visible}}
      <section class="payout-heading hub-status netrunner-decks">
        <h3>Netrunner · Cyberdecks</h3>
        {{#each netrunner.decks}}
          <div
            class="netrunner-deck item"
            data-item-id="{{id}}"
            data-item-category="cyberdeck"
          >
            <a
              class="netrunner-deck-name"
              data-deck-action="open"
              data-item-id="{{id}}"
            ><img src="{{img}}" alt="" />{{name}}</a>
            <div class="netrunner-deck-actions">
              <button
                type="button"
                data-deck-action="equip"
                data-item-id="{{id}}"
                data-item-prop="system.equipped"
                title="Cycle Owned / Carried / Equipped"
              ><i class="{{icon}}"></i> {{state}}</button>
              <button
                type="button"
                data-deck-action="programs"
                data-item-id="{{id}}"
              ><i class="fa-solid fa-folder-plus"></i> Manage Programs</button>
              <button
                type="button"
                data-deck-action="upgrades"
                data-item-id="{{id}}"
              ><i class="fab fa-superpowers"></i> Manage Upgrades</button>
            </div>
          </div>
        {{else}}<p class="notes">No cyberdecks in inventory.</p>{{/each}}
      </section>
    {{/if}}
    {{#if teammates.visible}}
      <fieldset class="payout-heading hub-status hub-teammates">
        <legend><i class="fas fa-user-tie"></i> Teammates</legend>
        <div class="hub-teammate-slots">
          {{#each teammates.slots}}
            <div class="hub-teammate-slot">
              {{#if occupied}}
                <div class="hub-teammate-heading">{{#if canOpen}}<button
                      type="button"
                      class="hub-teammate-name"
                      data-team-action="open"
                      data-slot="{{index}}"
                    ><img
                        class="hub-teammate-portrait"
                        src="{{img}}"
                        alt=""
                      /><span>{{name}}</span></button>{{else}}<button
                      type="button"
                      class="hub-teammate-name"
                      disabled
                    ><img
                        class="hub-teammate-portrait"
                        src="{{img}}"
                        alt=""
                      /><span>{{name}}</span></button>{{/if}}<button
                    type="button"
                    class="hub-teammate-remove"
                    data-team-action="remove"
                    data-slot="{{index}}"
                    aria-label="Remove teammate"
                    title="Remove teammate"
                  ><i class="fas fa-times"></i></button></div>
                <button
                  type="button"
                  class="hub-teammate-loyalty"
                  data-team-action="adjust"
                  data-slot="{{index}}"
                  title="Adjust Loyalty"
                >Loyalty
                  <strong>{{loyalty}}</strong>
                  <i class="fas fa-pen"></i></button>
                {{#if missing}}<button type="button" disabled><i
                      class="fas fa-dice-d6"
                    ></i>
                    Roll Loyalty Check</button>{{else}}<button
                    type="button"
                    data-team-action="roll"
                    data-slot="{{index}}"
                  ><i class="fas fa-dice-d6"></i>
                    Roll Loyalty Check</button>{{/if}}
                {{#if missing}}<small>Actor missing</small>{{/if}}
              {{else}}
                <span>Teammate {{number}}</span>
                <button
                  type="button"
                  data-team-action="add"
                  data-slot="{{index}}"
                ><i class="fas fa-plus"></i> Add Teammate</button>
              {{/if}}
            </div>
          {{/each}}
        </div>
      </fieldset>
    {{/if}}
    {{#if status.isMedtech}}
      <fieldset
        class="payout-heading hub-status downtime-medical hub-pharma"
        data-hub-pharma-panel
      >
        <legend><i class="fas fa-pills"></i> Administer Pharma</legend>
        {{#with pharma}}
          <div class="hub-pharma-layout">
            <label class="hub-pharma-recipient">Recipient
              <select name="recipientId" aria-label="Recipient">
                <option value="">Choose character</option>
                {{#each recipients}}<option
                    value="{{id}}"
                    {{ifThen selected "selected" ""}}
                  >{{name}}</option>{{/each}}
              </select>
            </label>
            <table class="hub-pharma-list" aria-label="Pharmaceuticals"><tbody>
                {{#each pharma}}<tr data-pharma-item="{{id}}">
                    <td>{{name}}</td><td title="Available doses">{{amount}}</td>
                    <td><button
                        type="button"
                        data-transfer-pharma="{{id}}"
                        {{ifThen amount "" "disabled"}}
                      ><i class="fas fa-syringe"></i> Administer</button></td>
                  </tr>{{else}}<tr><td colspan="3">No pharmaceuticals in
                      inventory.</td></tr>{{/each}}
              </tbody></table>
          </div>
          {{#if pending}}<h3>Awaiting acceptance</h3>{{#each pending}}
              <div class="pharma-pending-row">
                <span>{{itemName}} × {{amount}} → {{targetName}}</span>
                <button type="button" data-show-pharma-offer="{{id}}">Show offer
                  in chat</button>
              </div>
            {{/each}}{{/if}}
        {{/with}}
      </fieldset>
    {{/if}}
  {{/if}}
  <h2 class="hub-payout-heading"><i class="fas fa-coins"></i>
    {{#if gmDashboard}}Outstanding Acknowledgements & Rolls{{else}}Payouts{{/if}}</h2>

  {{#if isGM}}
    <section class="inbox-gm-panel">
      <label class="inbox-gm-actions">
        <input type="checkbox" data-enable-gm-actions />
        <span><strong>Enable GM controls for player actions</strong><small
          >Allows you to roll Humanity and acknowledge payouts on behalf of
            players. Disabled by default to prevent accidental actions.</small></span>
      </label>
      <div class="inbox-gm-bulk-actions">
        <button
          type="button"
          data-gm-inbox-action
          data-acknowledge-all
          data-available="{{hasAcknowledgments}}"
        ><i class="fas fa-check-double"></i> Acknowledge all</button>
        <button
          type="button"
          data-gm-inbox-action
          data-roll-all
          data-available="{{hasPendingRolls}}"
        ><i class="fas fa-dice"></i> Roll all</button>
        <button
          type="button"
          class="inbox-cancel-all"
          data-gm-inbox-action
          data-cancel-all-rolls
          data-available="{{hasPendingRolls}}"
        ><i class="fas fa-ban"></i> Cancel all rolls</button>
      </div>
    </section>
  {{/if}}

  {{#unless hasItems}}
    <p class="inbox-empty"><i class="fas fa-check-circle"></i>
      {{#if gmDashboard}}No outstanding acknowledgements or rolls.{{else}}No
        payouts are waiting for acknowledgement.{{/if}}</p>
  {{/unless}}

  <section class="inbox-card-list" aria-label="Pending payouts">
    {{#each cards}}
      <details
        class="inbox-card {{statusClass}}"
        data-inbox-expanded="{{expanded}}"
      >
        <summary class="inbox-card-header">
          <span class="inbox-card-title">
            <strong>{{sessionLabel}}</strong>
            <small>{{inGameDate}}</small>
          </span>
          <span class="inbox-card-actor">
            {{#if showUserName}}<small>{{userName}}</small>{{/if}}
            <strong>{{actorName}}</strong>
          </span>
          <span class="inbox-card-status">{{statusLabel}}</span>
        </summary>

        <div class="inbox-card-body">
          {{#if awards.length}}
            <ul class="inbox-awards">
              {{#each awards}}
                <li>
                  {{#if img}}
                    <img src="{{img}}" alt="" />
                  {{else}}
                    <i class="{{icon}} inbox-award-icon"></i>
                  {{/if}}
                  <span class="inbox-award-content">
                    {{#if label}}
                      <span><strong>{{label}}</strong>: {{value}}</span>
                      {{#if description}}<small>{{description}}</small>{{/if}}
                    {{else}}
                      <span>{{text}}</span>
                    {{/if}}
                  </span>
                </li>
              {{/each}}
            </ul>
          {{/if}}
        </div>

        <footer class="inbox-card-footer">
          {{#each pendingRolls}}
            <button
              type="button"
              data-player-inbox-action
              data-roll-id="{{id}}"
              data-actor-id="{{actorId}}"
            >
              <i class="fas fa-dice-d6"></i>
              {{actionLabel}}
              {{formula}}
            </button>
          {{/each}}
          {{#if acknowledgmentId}}
            <button
              type="button"
              data-player-inbox-action
              data-ack-id="{{acknowledgmentId}}"
              data-user-id="{{userId}}"
            >
              <i class="fas fa-check"></i>
              Acknowledge
            </button>
          {{/if}}
        </footer>
      </details>
    {{/each}}
  </section>
</form>