<form class="pneuma-calendar-form payout-inbox-form">
  <p class="notes" role="status">{{calendarStatus}}</p>
  <div class="calendar-current"><span>Current GameTime date</span><strong
    >{{currentDate}}</strong></div>
  <fieldset class="payout-heading hub-status"><legend><i
        class="fas fa-calendar-day"
      ></i>
      Set Exact Date</legend>
    <div class="calendar-date-fields"><label
        for="crew-calendar-month"
      >Month<select
          id="crew-calendar-month"
          name="month"
          {{disabled readOnly}}
        >{{#each months}}<option
              value="{{value}}"
              {{ifThen selected "selected" ""}}
            >{{name}}</option>{{/each}}</select></label><label
        for="crew-calendar-day"
      >Day<input
          id="crew-calendar-day"
          name="day"
          type="number"
          value="{{day}}"
          min="1"
          max="31"
          step="1"
          required
          {{disabled readOnly}}
        /></label><label for="crew-calendar-year">Year<input
          id="crew-calendar-year"
          name="year"
          type="number"
          value="{{year}}"
          min="1"
          max="9999"
          step="1"
          required
          {{disabled readOnly}}
        /></label></div>
    <div class="calendar-date-action"><small>Move forward or backward.</small><button
        type="submit"
        {{disabled readOnly}}
      >Set Date</button></div></fieldset>
  {{#if initialized}}<fieldset class="payout-heading hub-status"><legend><i
          class="fas fa-forward"
        ></i>
        Advance Days</legend><div class="calendar-advance-row"><label
          for="crew-calendar-days"
        >Days<input
            id="crew-calendar-days"
            name="days"
            type="number"
            value="1"
            min="1"
            step="1"
            {{disabled readOnly}}
          /></label><button
          type="button"
          data-calendar-advance
          {{disabled readOnly}}
        >Advance GameTime</button></div></fieldset>{{/if}}
  <p class="notes">Changes Foundry GameTime for the entire world.</p>{{#unless
    canEdit
  }}<p class="notes">The first active GM manages date changes.</p>{{/unless}}</form>